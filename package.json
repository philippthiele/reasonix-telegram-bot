{
  "name": "reasonix-telegram-bot",
  "version": "0.1.0",
  "description": "Telegram bot client for Reasonix: run and monitor coding tasks from chat.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "reasonix-telegram": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    ".env.example"
  ],
  "engines": {
    "node": "^22.14.0 || ^23.6.0 || >=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:rc": "node scripts/release-prepare.mjs rc",
    "release:notes:preview": "node scripts/release-notes-preview.mjs",
    "lint": "eslint src tests --max-warnings=0",
    "check-secrets": "node scripts/check-secrets.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check-secrets && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippthiele/reasonix-telegram-bot.git"
  },
  "keywords": [
    "reasonix",
    "telegram",
    "telegram-bot",
    "grammy",
    "developer-tools",
    "cli"
  ],
  "author": "Philipp Thiele",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philippthiele/reasonix-telegram-bot/issues"
  },
  "homepage": "https://github.com/philippthiele/reasonix-telegram-bot#readme",
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@grammyjs/menu": "^1.3.1",
    "@opencode-ai/sdk": "^1.18.8",
    "@opencode/client": "^2.0.16",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "https-proxy-agent": "^7.0.6",
    "mdast-util-to-string": "^4.0.0",
    "node-fetch": "^2.7.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "socks-proxy-agent": "^8.0.5",
    "unified": "^11.0.5",
    "ws": "^8.21.1"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "^6.1.3"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
